#
set -eo pipefail
shopt -s inherit_errexit

if command -v recycle &>/dev/null; then
  rm() { recycle --rm "$@"; }
fi

# shellcheck source=mods/bash/.local/lib/common.sh
. ~/.local/lib/common.sh

help() {
  cat <<'EOF'
Usage: cbz <directories...>

Turns one or more directories into CBZs.
EOF
}

parse_args \
  -h,--help \
  -- "$@"

err=

for dir in "${REST[@]}"; do
  if [[ ! -d $dir ]]; then # Makes it easy to just do `cbz *`
    echo "Skipping $dir: Not a directory"
    continue
  fi
  pushd "$dir"
  path=$(realpath .)
  name=$(basename "$path")
  cbz="../$name.cbz"
  if [[ -f $cbz ]]; then
    prints '\e[33malready exists: %s\e[m\n' "$cbz"
    err=1
    popd
    continue
  fi
  7z a -tzip -m0=Copy "../$name.cbz" .
  popd
  rm -rfv "$dir"
done

[[ ! $err ]]
