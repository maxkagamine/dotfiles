set -eo pipefail
shopt -s inherit_errexit

# shellcheck source=mods/bash/.local/lib/common.sh
. ~/.local/lib/common.sh

help() {
  cat <<EOF
Usage: mangadex <title> <url> [<gallery-dl args...>]

Creates a directory named <title> and runs gallery-dl & mangadex-covers in it.
EOF
}

parse_args \
  -h,--help \
  -- "$@"

title=${REST[0]}
url=${REST[1]}
args=("${REST[@]:2}")

if [[ ! $title || ! $url ]]; then
  wat
fi

mkdir -v "$title"
cd "$title"
gallery-dl "${args[@]}" "$url"
mangadex-covers "$url"
