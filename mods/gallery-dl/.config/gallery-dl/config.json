{
  "$docs": "https://gdl-org.github.io/docs/configuration.html",
  "extractor": {
    "mangadex": {
      "lang": "en",
      "directory": ["{manga} vol. {volume} [mangadex]"],
      "filename": "c{chapter:>03}{chapter_minor}{title:? //} p{page:>03} [{group|_lit[No Group]!S}].{extension}"
    },
    "batoto": {
      "directory": ["{manga} vol. {volume} [batoto]"],
      "filename": "c{chapter_url:>03}{title|chapter_string:? //} p{page:>03}.{extension}"
    },
    "dynastyscans": {
      "directory": ["{manga} [dynasty-scans]"],
      "filename": "c{chapter:>03}{chapter_minor}{title:? //} p{page:>03} [{group|_lit[No Group]!S}].{extension}"
    },
    "pixiv": {
      "filename": "\fF {title} [{re.sub('[@＠].*', '', user['name'])}] [pixiv {id}_p{num}].{extension}",
      "ugoira": "original",
      "postprocessors": [
        {
          "name": "ugoira",
          "mode": "archive",
          "mtime": false
        },
        {
          "name": "exec",
          "command": "mv -n {} \"$(perl -pe 's/_ugoira\\d+\\]\\.zip$/].zip/' <<<{})\""
        }
      ]
    },
    "fanbox": {
      "filename": "\fF [{date:%Y-%m-%d}] {title} [{re.sub('[@＠].*', '', user['name'])}] [{creatorId} fanbox {id}_p{num}].{extension}",
      "directory": ["\fF [{date:%Y-%m-%d}] {title}"],
      "embeds": "ytdl"
    },
    "bluesky": {
      "filename": "{date:%Y-%m-%d}{text:? //[:50]} [{author[displayName]} @{author[handle]}] [bluesky {post_id}_p{num}].{extension:Rjpeg/jpg/}"
    },
    "twitter": {
      "filename": "{date:%Y-%m-%d}{content:? //[:50]} [@{user[name]}] [twitter {tweet_id}_p{num}].{extension}"
    },
    "mastodon": {
      "filename": "{date:%Y-%m-%d}{content!H:? //R# /#/[:50]} [{account[display_name]:?/ /}@{account[username]}] [{instance} {id}_p{num}].{extension}"
    },
    "seiga": {
      "filename": "{title} [{user[name]}] [seiga im{image_id}].{extension}"
    },
    "gelbooru": {
      "tags": true,
      "filename": "{tags_copyright:?/ /}{tags_character:?/ /}{tags_artist:?[/] /}[gelbooru {id}].{extension}",
      "user-agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/147.0.0.0 Safari/537.36",
      "browser": "chrome"
    },
    "yandere": {
      "tags": true,
      "filename": "{tags_copyright:?/ /}{tags_character:?/ /}{tags_artist:?[/] /}[yandere {id}].{extension}",
      "user-agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/147.0.0.0 Safari/537.36",
      "browser": "chrome"
    },
    "newgrounds": {
      "filename": "{title} [{user}] [newgrounds {index}_p{num}].{extension}"
    },
    "deviantart": {
      "filename": "{title} [{username}] [deviantart {index}_p{num}].{extension}",
      "public": false,
      "original": true,
      "quality": "png"
    },
    "misskey.io": {
      "filename": "\fF {date:%Y-%m-%d}{' ' + text[:50] if text else ''} [{re.sub(':.*?:', '', user['name'])} @{user['username']}] [misskey {id}_p{num}].{extension}"
    },
    "artstation": {
      "filename": "{title} [{userinfo[full_name]}] [artstation {hash_id}_p{num}].{extension}"
    },
    "base-directory": ".",
    "directory": [],
    "path-restrict": {
      "\\": "⧹",
      "/": "⧸",
      "|": "￨",
      ":": "꞉",
      "*": "∗",
      "?": "？",
      "\"": "″",
      "<": "﹤",
      ">": "﹥"
    },
    "path-strip": "windows"
  },
  "downloader": {
    "mtime": false,
    "ytdl": {
      "config-file": "~/.config/yt-dlp.conf"
    }
  },
  "subconfigs": [
    "~/.config/gallery-dl/config.local.json"
  ]
}
